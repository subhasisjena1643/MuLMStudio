# µLM Studio — backend environment (tracer.py)
# Copy to `.env` at the repo root. Loaded automatically via python-dotenv on
# local dev; in a real deployment, set these as env vars on the host instead
# (Render/Railway/Fly.io/etc. dashboards, not a checked-in file).

# Required for the "Ask Claude" / architecture-map / Debug-panel features.
# This key is server-side only — it is never sent to the browser. See the
# POST /claude/messages proxy in tracer.py.
ANTHROPIC_API_KEY=your-key-here

# Comma-separated list of extra frontend origins allowed to call this backend,
# on top of the built-in localhost dev/preview ports. Needed once the
# frontend is deployed somewhere other than localhost.
# ALLOWED_ORIGINS=https://your-deployed-frontend.example.com

# Most PaaS hosts inject this automatically — only set it yourself for a
# custom local port.
# PORT=8002
