# µLM Studio — frontend environment
# Copy to .env.local (gitignored). No values are required for local dev —
# the defaults below already match a locally-running backend.

# "true" runs the static demo (no WebSocket, no backend needed).
VITE_DEMO_MODE=false

# Where the backend (tracer.py) lives. Defaults to http://localhost:8002 if
# unset — only set this when the frontend is deployed separately from the
# backend (see studio/src/config.js). Do NOT put the Anthropic API key here;
# it lives server-side only — see the root .env.example instead.
# VITE_BACKEND_URL=https://your-backend-host.example.com
